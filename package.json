{
  "name": "gestao-precos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --experimental-strip-types server/index.ts\" \"vite --configLoader native --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build --configLoader native && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "demo": "node --experimental-strip-types server/demo.ts",
    "check": "tsc --noEmit",
    "backup:offline": "node scripts/backup-offline.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.7",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "esbuild": "npm:esbuild-wasm@^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}